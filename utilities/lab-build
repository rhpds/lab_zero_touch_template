#!/usr/bin/env bash
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

echo "Starting build process..."
echo "Removing old site..."
rm -rf ./www/*

echo "Building new site..."
# Check if podman exists, otherwise use docker
CONTAINER_CMD="docker"
if command -v podman &> /dev/null; then
    CONTAINER_CMD="podman"
fi
if ! $CONTAINER_CMD run --rm --name showroom-builder --platform linux/amd64 \
    -v "./:/antora:z" \
    docker.io/antora/antora --stacktrace site.yml; then
    echo ""
    echo "ERROR: Antora build failed. Fix the errors above before continuing."
    exit 1
fi
# Write a local-preview copy of ui-config.yml into www/ with:
#   - tabs stripped (type:terminal / port:443 tabs load https://localhost:443 and
#     cause Firefox to show "problem with this site" in local preview)
#   - view_switcher injected (default_mode: instructions = full-width content pane)
# The source ui-config.yml is NOT modified — it keeps full production tabs.
python3 - <<'PY'
import sys
from pathlib import Path
try:
    import yaml
except ImportError:
    print("lab-build: pyyaml not available; falling back to plain copy of ui-config.yml.", file=sys.stderr)
    import shutil
    shutil.copy("ui-config.yml", "www/ui-config.yml")
    raise SystemExit(0)

src = Path("ui-config.yml")
dst = Path("www/ui-config.yml")
config = yaml.safe_load(src.read_text(encoding="utf-8"))

# Strip tabs that would try to load https://localhost:443/... in a local iframe.
# A tab is "cluster-only" when it has type:terminal/double-terminal/secondary-terminal
# or derives a URL with port:443 (these are the wetty/tty presets).
CLUSTER_TYPES = {"terminal", "double-terminal", "secondary-terminal"}
def is_cluster_tab(tab):
    return str(tab.get("type","")) in CLUSTER_TYPES or str(tab.get("port","")) == "443"

original_tabs = config.get("tabs") or []
safe_tabs = [t for t in original_tabs if not is_cluster_tab(t)]
stripped = [t["name"] for t in original_tabs if is_cluster_tab(t)]

config["tabs"] = safe_tabs

# Inject view_switcher only when tabs remain (gives a usable switcher for external links).
# If no tabs at all, nookbag already fills the full width automatically.
if safe_tabs and not config.get("view_switcher"):
    config["view_switcher"] = {"enabled": True, "default_mode": "instructions"}
    vs_injected = True
else:
    vs_injected = False

dst.write_text(
    "# Local-preview copy generated by lab-build — do not edit.\n"
    "# Cluster-only tabs stripped; edit ui-config.yml (source) instead.\n"
    + yaml.dump(config, default_flow_style=False, allow_unicode=True),
    encoding="utf-8",
)

if stripped:
    print(f"Stripped {len(stripped)} cluster-only tab(s) from www/ui-config.yml for local preview: {stripped}")
if vs_injected:
    print("Injected view_switcher (default_mode: instructions) into www/ui-config.yml.")
print("Wrote www/ui-config.yml (source ui-config.yml unchanged).")
PY

# Nookbag always GETs ./ui-config.yml and ./zero-touch-config.yml (see nookbag app.tsx).
# AgnosticD showroom render: if the content repo has zero-touch-config.yml it is copied
# into www/; otherwise only ui-config.yml is published — the second URL 404s in prod
# too, and nookbag uses the first successful response. For local preview, provide the
# optional file so both requests succeed (avoids confusing "network" / failed rows in
# DevTools when anything causes fetch to reject instead of returning 404).
if [[ -f ./zero-touch-config.yml ]]; then
  cp ./zero-touch-config.yml ./www/zero-touch-config.yml
  echo "Copied ./zero-touch-config.yml into www/ (lab-specific ZT config)."
else
  if ln -sf ui-config.yml www/zero-touch-config.yml 2>/dev/null; then
    echo "Linked www/zero-touch-config.yml -> ui-config.yml (local preview only; not committed)."
  else
    cp ./ui-config.yml ./www/zero-touch-config.yml
    echo "Copied ui-config.yml to www/zero-touch-config.yml (symlink unavailable; local preview only)."
  fi
fi

if test -f "/tmp/nookbag.zip"; then
    echo "UI already downloaded."
else
    echo "Downloading UI..."
    wget -q https://github.com/rhpds/nookbag/releases/download/nookbag-v0.3.6/nookbag-v0.3.6.zip -O /tmp/nookbag.zip
fi

unzip -q /tmp/nookbag.zip -d ./www/

echo "Build process complete. Check the ./www folder for the generated site."

echo "To view the site locally, run the following command: utilities/lab-serve"
echo "Then open http://localhost:8080/ (or http://localhost:8080/index.html)"
